# Server Configuration
MCP_SERVER_NAME=universal-db-mcp
ALLOW_DESTRUCTIVE=false
MAX_RESULT_ROWS=1000
ENABLE_LOGGING=true
QUERY_TIMEOUT=30

# Rate Limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# Dry-run mode: validate and EXPLAIN queries without executing them
DRYRUN=false

# Query complexity guard
MAX_JOINS=5
WARN_SELECT_STAR_NO_LIMIT=true

# PostgreSQL Configuration (use URI or individual settings)
POSTGRES_URI=postgresql://user:password@localhost:5432/mydb
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=mydb
# POSTGRES_USER=myuser
# POSTGRES_PASSWORD=mypassword
# POSTGRES_SSL=false
# POSTGRES_READONLY=true
# POSTGRES_MAX_CONN=10

# SQLite Configuration
SQLITE_PATH=/path/to/database.db
SQLITE_READONLY=true

# MySQL Configuration (use URI or individual settings)
MYSQL_URI=mysql://user:password@localhost:3306/mydb
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=mydb
# MYSQL_USER=myuser
# MYSQL_PASSWORD=mypassword
# MYSQL_SSL=false
# MYSQL_READONLY=true
# MYSQL_MAX_CONN=10

# Table allowlist (optional, comma-separated). When set, queries referencing
# any other table are rejected.
# WHITELISTED_TABLES=users,orders,products
